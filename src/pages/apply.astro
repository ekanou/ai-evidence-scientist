---
import BaseLayout from '../layouts/BaseLayout.astro';
import Ph from '../components/Ph.astro';
import { WORKSHOP_NAME, YEAR, SHOW_PROJECTS, APPLICATIONS, applicationMailto } from '../config';
import { href } from '../lib/url';

const toc = [
  { id: 'who', label: 'Who should apply' },
  { id: 'funding', label: 'Remuneration' },
  { id: 'how', label: 'How to apply' },
  { id: 'decisions', label: 'Decisions' },
];
---
<BaseLayout
  title="Apply"
  description="Who should apply to the workshop, the internship remuneration, how to apply and when decisions are made."
  toc={toc}
>
  <h1>Apply to {WORKSHOP_NAME} {YEAR}</h1>
  <p class="lede">
    An in-person internship of at least eight weeks (the length of Project AI) at the University of
    Amsterdam, for your Project AI or MSc thesis.
    Decisions are made on a rolling basis, so apply early.
  </p>

  <dl class="facts">
    <div><dt>Dates</dt><dd><Ph k="DATES" /></dd></div>
    <div><dt>Location</dt><dd><Ph k="LOCATION" /></dd></div>
    <div><dt>Applications</dt><dd>{APPLICATIONS}</dd></div>
  </dl>

  <section aria-labelledby="who">
    <h2 id="who">Who should apply</h2>
    <p>
      The call is for MSc AI students at the University of Amsterdam who want to do their Project AI or their
      MSc thesis on agentic AI for systematic reviews. You do not need medical training; see
      the <a href={href('/faq')}>FAQ</a>.
    </p>
    {SHOW_PROJECTS ? (
      <p>
        You do not choose a project when you apply. The <a href={href('/projects')}>projects</a> show the kinds
        of work on offer: each one fits the eight weeks of Project AI and describes how it extends into a
        thesis. The research areas behind them are
        in <a href={`${href('/')}#research-areas`}>the call</a>, and the task and scoring design is on
        the <a href={href('/data-and-evaluation')}>data and evaluation</a> page.
      </p>
    ) : (
      <p>
        The research areas are listed
        in <a href={`${href('/')}#research-areas`}>the call</a>, and the task and scoring design is on
        the <a href={href('/data-and-evaluation')}>data and evaluation</a> page.
      </p>
    )}
  </section>

  <section aria-labelledby="funding">
    <h2 id="funding">Remuneration</h2>
    <p><Ph k="FUNDING_DETAILS" /></p>
  </section>

  <section aria-labelledby="how">
    <h2 id="how">How to apply</h2>
    <p>
      Send a CV and a short note on your interest to <Ph k="CONTACT_EMAIL" as="email" />. In the note, tell us
      what draws you to the problem, what you would bring to it, and whether you would take the work as your
      Project AI or your MSc thesis.
    </p>
    {applicationMailto() && (
      <p class="actions">
        <a class="button" href={applicationMailto()}>Email your application</a>
      </p>
    )}
  </section>

  <section aria-labelledby="decisions">
    <h2 id="decisions">Decisions</h2>
    <p>
      There is no deadline. Applications are reviewed on a rolling basis, so apply early.
    </p>
  </section>
</BaseLayout>

<style>
  h1 + .lede {
    margin-top: var(--space-4);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: var(--space-3) var(--space-5);
    margin: var(--space-5) 0 0;
    padding-top: var(--space-3);
    border-top: 1px solid var(--rule);
    max-width: var(--figure-max);
    font-family: var(--sans);
    font-size: var(--text-small);
    line-height: 1.4;
  }

  .facts dt {
    font-size: var(--text-xsmall);
    font-weight: 600;
    color: var(--muted);
    margin-bottom: 0.15rem;
  }

  .facts dd {
    margin: 0;
  }

  .actions {
    margin-top: var(--space-4);
  }
</style>
