---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Ph from '../components/Ph.astro';
import { placeholders, PROJECT_LEAD } from '../config';

const people = (await getCollection('people')).map((p) => p.data).sort((a, b) => a.order - b.order);
const lead = people.filter((p) => p.role === 'lead');
const organisers = people.filter((p) => p.role === 'organiser');
const advisors = people.filter((p) => p.role === 'advisor');
const partners = placeholders.PARTNER_INSTITUTIONS.value ?? [];
---
<BaseLayout title="People" description="The organising group, partner institutions and methodologist advisors for the workshop.">
  <h1>People</h1>
  <p class="lede">The organising group is being formed. Get in touch if you would like to be part of it.</p>
  <p>
    We are looking for co-organisers, partner institutions, and clinical methodologists, evidence-synthesis
    specialists and biostatisticians who can advise on task design and adjudicate the conclusions that
    systems are scored against. Write to {PROJECT_LEAD.name}
    at <a href={`mailto:${PROJECT_LEAD.email}`}>{PROJECT_LEAD.email}</a>.
  </p>

  <section aria-labelledby="lead">
    <h2 id="lead">Project lead</h2>
    <ul class="people">
      {lead.map((p) => (
        <li>
          <span class="name">{p.name}</span>
          <span class="aff">{p.affiliation}</span>
          {p.email && <a class="sans" href={`mailto:${p.email}`}>{p.email}</a>}
        </li>
      ))}
    </ul>
  </section>

  <section aria-labelledby="organisers">
    <h2 id="organisers">Organisers</h2>
    {organisers.length > 0 ? (
      <ul class="people">
        {organisers.map((p) => (
          <li><span class="name">{p.name}</span> <span class="aff">{p.affiliation}</span></li>
        ))}
      </ul>
    ) : (
      <p class="empty"><Ph k="ORGANISERS" />. Names will be listed here once confirmed.</p>
    )}
  </section>

  <section aria-labelledby="partners">
    <h2 id="partners">Partner institutions</h2>
    {partners.length > 0 ? (
      <ul class="people">{partners.map((p) => <li><span class="name">{p}</span></li>)}</ul>
    ) : (
      <p class="empty"><Ph k="PARTNER_INSTITUTIONS" />.</p>
    )}
  </section>

  <section aria-labelledby="advisors">
    <h2 id="advisors">Methodologist advisors</h2>
    {advisors.length > 0 ? (
      <ul class="people">
        {advisors.map((p) => (
          <li><span class="name">{p.name}</span> <span class="aff">{p.affiliation}</span></li>
        ))}
      </ul>
    ) : (
      <p class="empty">To be announced. We are inviting advisors now.</p>
    )}
  </section>
</BaseLayout>

<style>
  h1 + .lede {
    margin-top: var(--space-4);
  }

  .people {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .people li {
    display: grid;
    gap: 0.1rem;
    padding-block: var(--space-2);
  }

  .name {
    font-weight: 600;
  }

  .aff {
    color: var(--muted);
  }

  .people .sans {
    font-size: var(--text-small);
    justify-self: start;
  }

  .empty {
    color: var(--muted);
  }
</style>
