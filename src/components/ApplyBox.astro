---
import Ph from './Ph.astro';
import { href } from '../lib/url';

interface Props {
  headingId?: string;
}
const { headingId = 'apply' } = Astro.props;
---
<section class="apply-box" aria-labelledby={headingId}>
  <h2 id={headingId}>Apply</h2>
  <p>
    We invite MSc AI students at the University of Amsterdam who want to do their Project AI or their MSc
    thesis on this problem to apply. The position is an internship with a light remuneration. Send a CV and a
    short note on your interest to <Ph k="CONTACT_EMAIL" as="email" />.
    There is no deadline: applications are reviewed on a rolling basis, so apply early.
  </p>
  <p class="actions">
    <a class="button" href={href('/apply')}>How to apply</a>
  </p>
</section>

<style>
  .apply-box {
    margin-top: var(--space-8);
    padding: var(--space-5) var(--space-5) var(--space-4);
    background: var(--wash);
    border-top: 2px solid var(--ink);
    max-width: var(--figure-max);
  }

  h2 {
    margin: 0 0 var(--space-3);
    padding: 0;
    border: 0;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
    margin: var(--space-4) 0 0;
  }
</style>
