---
/**
 * Renders a placeholder value from src/config.ts.
 * In `astro dev`, unconfirmed values get a dashed outline and their key.
 * `as="email"` renders mailto links once the value is filled (a list becomes "a and b").
 */
import { placeholders, text, type PlaceholderKey } from '../config';

interface Props {
  k: PlaceholderKey;
  as?: 'text' | 'email';
}

const { k, as = 'text' } = Astro.props;
const ph = placeholders[k];
const value = text(k);
const flag = import.meta.env.DEV && !ph.confirmed;
const emails: string[] | null =
  as === 'email' && ph.value !== null ? (Array.isArray(ph.value) ? ph.value : [String(ph.value)]) : null;
---
{emails ? (
  <span class="ph" data-key={k} data-dev={flag ? '' : undefined}>
    {emails.map((e, i) => (
      <>
        {i > 0 && (i === emails.length - 1 ? ' and ' : ', ')}
        <a href={`mailto:${e}`}>{e}</a>
      </>
    ))}
  </span>
) : flag ? (
  <span class="ph" data-key={k} data-dev="">{value}</span>
) : (
  <Fragment>{value}</Fragment>
)}
