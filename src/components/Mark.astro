---
/** The site mark: a three-row forest plot in miniature. Decorative. */
interface Props { size?: number }
const { size = 22 } = Astro.props;
---
<svg class="mark" width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  <line x1="8" y1="2" x2="8" y2="22" stroke="#1b2430" stroke-width="1.25" />
  <rect x="5.5" y="3.5" width="5" height="5" fill="#2f6f6a" />
  <rect x="14.25" y="8.75" width="6.5" height="6.5" fill="#2f6f6a" />
  <path d="M10 19.5 L15.5 16.5 L21 19.5 L15.5 22.5 Z" fill="#c08a1e" />
</svg>
