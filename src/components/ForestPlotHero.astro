---
/**
 * Interactive forest plot (CLAUDE.md §5). Illustrative numbers only.
 *
 * Server output is the full four-study plot as static HTML + SVG. The script
 * below upgrades each study row to a toggle button; without JS nothing is
 * clickable and nothing is broken.
 *
 * Geometry: each plot cell is an SVG with no viewBox, so x positions can be
 * given in % of the cell width and every row shares one x scale. Rows abut,
 * so per-row line segments read as continuous vertical lines.
 */
import { STUDIES, DOMAIN, pooledEffect, xPercent, squareSide, readout, fmt } from '../lib/forest';

const pooled = pooledEffect(STUDIES.map(() => true));
const totalWeight = STUDIES.reduce((s, x) => s + x.weight, 0);
const ticks = [0, 0.5, 1];
const ROW_H = 40;
const DIAMOND_HALF_W = 14;
const DIAMOND_HALF_H = 9;
---
<figure class="fp" id="figure-1" data-fp aria-labelledby="fp-title">
  <div class="fp-head">
    <p class="fp-title" id="fp-title"><span class="fig-num">Figure 1</span> Why recall cannot price an omission</p>
    <p class="fp-instr" data-fp-instr hidden>
      Select a study to exclude it. Try excluding study B, then study D instead.
    </p>
  </div>

  <div class="fp-grid" data-fp-grid>
    <div class="fp-row fp-colhead" aria-hidden="true">
      <span class="fp-label">Study</span>
      <span class="fp-plotcell"></span>
      <span class="fp-num">Effect</span>
      <span class="fp-num">Weight</span>
    </div>

    {STUDIES.map((s, i) => {
      const side = squareSide(s.weight);
      return (
        <div
          class="fp-row fp-study"
          data-fp-row={i}
          data-label={s.label}
          data-effect={s.effect}
          data-weight={s.weight}
        >
          <span class="fp-label">
            <span class="fp-check" aria-hidden="true"></span>
            <span class="fp-name">Study {s.label}</span>
          </span>
          <svg class="fp-plotcell" width="100%" height={ROW_H} aria-hidden="true" focusable="false">
            <line class="fp-zero" x1={`${xPercent(0)}%`} x2={`${xPercent(0)}%`} y1="0" y2={ROW_H} />
            <line class="fp-pooled-line" data-fp-pline x1={`${xPercent(pooled!)}%`} x2={`${xPercent(pooled!)}%`} y1="0" y2={ROW_H} />
            <svg x={`${xPercent(s.effect)}%`} y={ROW_H / 2} overflow="visible">
              <rect class="fp-square" x={-side / 2} y={-side / 2} width={side} height={side} />
            </svg>
          </svg>
          <span class="fp-num">{fmt(s.effect)}</span>
          <span class="fp-num" data-fp-share>
            {Math.round((s.weight / totalWeight) * 100)}%
          </span>
        </div>
      );
    })}

    <div class="fp-row fp-pooled">
      <span class="fp-label">
        <span class="fp-name">Pooled</span>
        <span class="fp-sub">fixed effect</span>
      </span>
      <svg class="fp-plotcell" width="100%" height={ROW_H + 4} aria-hidden="true" focusable="false">
        <line class="fp-zero" x1={`${xPercent(0)}%`} x2={`${xPercent(0)}%`} y1="0" y2={ROW_H + 4} />
        <svg data-fp-diamond x={`${xPercent(pooled!)}%`} y={(ROW_H + 4) / 2} overflow="visible">
          <path
            class="fp-diamond"
            d={`M ${-DIAMOND_HALF_W} 0 L 0 ${-DIAMOND_HALF_H} L ${DIAMOND_HALF_W} 0 L 0 ${DIAMOND_HALF_H} Z`}
          />
        </svg>
      </svg>
      <span class="fp-num fp-pooled-value" data-fp-pvalue>{fmt(pooled!)}</span>
      <span class="fp-num">100%</span>
    </div>

    <div class="fp-row fp-axis" aria-hidden="true">
      <span class="fp-label"></span>
      <svg class="fp-plotcell" width="100%" height="46" focusable="false">
        <line class="fp-axisline" x1={`${xPercent(DOMAIN[0])}%`} x2={`${xPercent(DOMAIN[1])}%`} y1="0.5" y2="0.5" />
        {ticks.map((t) => (
          <g>
            <line class="fp-tick" x1={`${xPercent(t)}%`} x2={`${xPercent(t)}%`} y1="0" y2="6" />
            <text class="fp-ticklabel" x={`${xPercent(t)}%`} y="20" text-anchor="middle">{fmt(t, 1)}</text>
          </g>
        ))}
        <text class="fp-axistitle" x="50%" y="40" text-anchor="middle">Effect (illustrative units)</text>
      </svg>
      <span class="fp-num"></span>
      <span class="fp-num"></span>
    </div>
  </div>

  <div class="fp-foot">
    <p class="fp-readout" data-fp-readout aria-live="polite">{readout(STUDIES.map(() => true))}</p>
    <button type="button" class="fp-reset" data-fp-reset hidden>Include all four studies</button>
  </div>

  <figcaption class="fp-caption">
    <strong>Illustrative numbers. Same recall, opposite conclusions.</strong>{' '}
    Squares show study effects, with area proportional to weight (1, 1, 1 and 7). The diamond is the
    fixed-effect pooled estimate, the weighted mean of the included studies; its width is symbolic, not a
    confidence interval. Excluding study B leaves 3 of 4 studies and a pooled effect of 0.78. Excluding
    study D also leaves 3 of 4 studies, and the pooled effect falls to 0.00.
  </figcaption>
</figure>

<script>
  import { STUDIES, pooledEffect, xPercent, readout, fmt } from '../lib/forest';

  const DURATION = 450;
  const easeOutCubic = (t: number) => 1 - Math.pow(1 - t, 3);
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  for (const fig of document.querySelectorAll<HTMLElement>('[data-fp]')) {
    const included = STUDIES.map(() => true);
    const total = (inc: boolean[]) => STUDIES.reduce((s, x, i) => s + (inc[i] ? x.weight : 0), 0);

    const readoutEl = fig.querySelector<HTMLElement>('[data-fp-readout]')!;
    const resetBtn = fig.querySelector<HTMLButtonElement>('[data-fp-reset]')!;
    const pvalue = fig.querySelector<HTMLElement>('[data-fp-pvalue]')!;
    const diamond = fig.querySelector<SVGSVGElement>('[data-fp-diamond]')!;
    const plines = [...fig.querySelectorAll<SVGLineElement>('[data-fp-pline]')];

    let shownX = xPercent(pooledEffect(included)!);
    let frame = 0;

    const setX = (x: number) => {
      const v = `${x}%`;
      diamond.setAttribute('x', v);
      for (const l of plines) {
        l.setAttribute('x1', v);
        l.setAttribute('x2', v);
      }
    };

    const moveTo = (target: number) => {
      cancelAnimationFrame(frame);
      if (reducedMotion.matches) {
        shownX = target;
        setX(target);
        return;
      }
      const from = shownX;
      const start = performance.now();
      const step = (now: number) => {
        const t = Math.min(1, (now - start) / DURATION);
        shownX = from + (target - from) * easeOutCubic(t);
        setX(shownX);
        if (t < 1) frame = requestAnimationFrame(step);
      };
      frame = requestAnimationFrame(step);
    };

    // Upgrade each static study row to a toggle button.
    const buttons: HTMLButtonElement[] = [];
    for (const row of fig.querySelectorAll<HTMLElement>('[data-fp-row]')) {
      const i = Number(row.dataset.fpRow);
      const s = STUDIES[i];
      const btn = document.createElement('button');
      // Copy class and data attributes (incl. Astro's scoped-style attribute).
      for (const a of [...row.attributes]) btn.setAttribute(a.name, a.value);
      btn.type = 'button';
      btn.setAttribute('aria-pressed', 'true');
      btn.setAttribute('aria-label', `Include study ${s.label} (effect ${fmt(s.effect)}, weight ${s.weight})`);
      btn.append(...row.childNodes);
      row.replaceWith(btn);
      buttons.push(btn);
      btn.addEventListener('click', () => {
        included[i] = !included[i];
        render();
      });
    }

    const render = () => {
      const tw = total(included);
      buttons.forEach((btn, i) => {
        btn.setAttribute('aria-pressed', String(included[i]));
        btn.classList.toggle('is-excluded', !included[i]);
        const share = btn.querySelector<HTMLElement>('[data-fp-share]')!;
        share.innerHTML = included[i]
          ? `${Math.round((STUDIES[i].weight / tw) * 100)}%`
          : '<span aria-hidden="true">—</span><span class="visually-hidden">excluded</span>';
      });

      const pooled = pooledEffect(included);
      fig.classList.toggle('is-empty', pooled === null);
      if (pooled !== null) {
        pvalue.textContent = fmt(pooled);
        moveTo(xPercent(pooled));
      } else {
        pvalue.textContent = '—';
      }
      readoutEl.textContent = readout(included);
      resetBtn.hidden = included.every(Boolean);
    };

    resetBtn.addEventListener('click', () => {
      included.fill(true);
      render();
      buttons[0]?.focus();
    });

    fig.querySelector<HTMLElement>('[data-fp-instr]')!.hidden = false;
    fig.classList.add('is-interactive');
  }
</script>

<style>
  .fp {
    margin: var(--space-6) 0 0;
    max-width: var(--figure-max);
    border-top: 2px solid var(--ink);
    border-bottom: 1px solid var(--rule);
    padding-block: var(--space-4) var(--space-4);
    font-family: var(--sans);
    font-variant-numeric: tabular-nums lining-nums;
  }

  .fp-head {
    margin-bottom: var(--space-3);
  }

  .fp-title {
    font-size: var(--text-small);
    font-weight: 600;
    margin: 0;
  }

  .fig-num {
    font-weight: 700;
    margin-right: 0.4em;
  }

  .fp-instr {
    font-size: var(--text-xsmall);
    color: var(--muted);
    margin: var(--space-1) 0 0;
  }

  /* ---- Grid rows ---- */
  .fp-grid {
    --col-label: 5.6rem;
    --col-num: 3.1rem;
    display: grid;
    grid-template-columns: var(--col-label) minmax(0, 1fr) var(--col-num) var(--col-num);
  }

  @media (min-width: 40rem) {
    .fp-grid {
      --col-label: 7.5rem;
      --col-num: 4.25rem;
    }
  }

  .fp-row {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    align-items: center;
    column-gap: 0;
    /* reset button chrome when upgraded */
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: inherit;
    text-align: inherit;
    width: 100%;
  }

  .fp-colhead {
    font-size: var(--text-xsmall);
    font-weight: 600;
    color: var(--muted);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--rule);
  }

  .fp-label {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: var(--text-small);
    padding-left: 0.25rem;
    min-width: 0;
  }

  .fp-sub {
    display: block;
    font-size: var(--text-xsmall);
    color: var(--muted);
  }

  .fp-pooled .fp-label {
    display: block;
    line-height: 1.25;
  }

  .fp-pooled .fp-name {
    font-weight: 700;
  }

  .fp-num {
    text-align: right;
    font-size: var(--text-small);
    padding-right: 0.25rem;
  }

  .fp-colhead .fp-num {
    font-size: var(--text-xsmall);
  }

  .fp-plotcell {
    display: block;
    width: 100%;
    overflow: visible;
  }

  /* ---- Marks ---- */
  .fp-zero {
    stroke: var(--ink);
    stroke-width: 1;
  }

  .fp-pooled-line {
    stroke: var(--pooled);
    stroke-width: 1.5;
    stroke-dasharray: 2 3;
  }

  .fp-square {
    fill: var(--study);
    stroke: var(--study);
    stroke-width: 1.25;
  }

  .fp-diamond {
    fill: var(--pooled);
    stroke: var(--pooled-text);
    stroke-width: 1;
  }

  .fp-pooled {
    border-top: 1px solid var(--rule);
  }

  .fp-pooled-value {
    font-weight: 700;
    color: var(--pooled-text);
  }

  .fp-axisline,
  .fp-tick {
    stroke: var(--ink);
    stroke-width: 1;
  }

  .fp-ticklabel,
  .fp-axistitle {
    font-family: var(--sans);
    font-size: 12px;
    fill: var(--ink);
  }

  .fp-axistitle {
    fill: var(--muted);
  }

  /* ---- Interactive state (added by the script) ---- */
  .fp-check {
    display: none;
  }

  .is-interactive .fp-check {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 0.95rem;
    height: 0.95rem;
    border: 1.5px solid var(--ink);
    border-radius: 2px;
  }

  .is-interactive .fp-study[aria-pressed='true'] .fp-check::after {
    content: '';
    width: 0.3rem;
    height: 0.55rem;
    border-right: 2px solid var(--ink);
    border-bottom: 2px solid var(--ink);
    transform: translateY(-12%) rotate(45deg);
  }

  button.fp-study {
    cursor: pointer;
    border-radius: var(--radius);
  }

  button.fp-study:hover {
    background: var(--wash);
  }

  button.fp-study:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: -3px;
  }

  .fp-study.is-excluded .fp-name,
  .fp-study.is-excluded .fp-num {
    color: var(--muted);
  }

  .fp-study.is-excluded .fp-name {
    text-decoration: line-through;
    text-decoration-thickness: 1.5px;
  }

  .fp-study.is-excluded .fp-square {
    fill: var(--paper);
    stroke: var(--muted);
    stroke-dasharray: 2 2;
  }

  .is-empty .fp-pooled-line,
  .is-empty [data-fp-diamond] {
    display: none;
  }

  /* ---- Readout and caption ---- */
  .fp-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--rule);
  }

  .fp-readout {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
  }

  .fp-reset {
    font: inherit;
    font-size: var(--text-xsmall);
    font-weight: 600;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--muted);
    border-radius: var(--radius);
    padding: 0.45rem 0.75rem;
    min-height: 2.25rem;
    cursor: pointer;
  }

  .fp-reset:hover {
    border-color: var(--ink);
  }

  .fp-reset[hidden] {
    display: none;
  }

  .fp-caption {
    margin-top: var(--space-3);
    font-size: var(--text-xsmall);
    line-height: 1.5;
    color: var(--muted);
    max-width: 62ch;
  }

  .fp-caption strong {
    color: var(--ink);
    font-weight: 600;
  }
</style>
